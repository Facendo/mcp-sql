# ─────────────────────────────────────────────────────────────────────────────
#  Copia este archivo a .env y completalo:   cp .env.example .env
#  Despues protegelo:                        chmod 600 .env
#  El .env NUNCA se versiona (esta en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Conexion (a traves del tunel SSH local) ──────────────────────────────────
# DB_HOST/DB_PORT apuntan al extremo LOCAL del tunel, no al VPS directamente.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── Limites de lectura (protegen tu contexto, no la base de datos) ───────────
MAX_ROWS=200                # tope duro de filas por consulta
MAX_CELL_CHARS=500          # truncado de celdas TEXT/BLOB
MAX_RESPONSE_BYTES=100000   # presupuesto total por respuesta
QUERY_TIMEOUT_MS=15000      # max_execution_time de la sesion MySQL

# ── Seguridad ────────────────────────────────────────────────────────────────
# Con true, el servidor ejecuta SHOW GRANTS FOR CURRENT_USER() al arrancar y se
# NIEGA a arrancar si DB_USER tiene cualquier permiso de escritura.
ENFORCE_READ_ONLY_USER=true
