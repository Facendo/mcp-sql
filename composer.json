{
    "name": "toposoft/mcp-sql",
    "description": "Servidor MCP de solo lectura para generar reportes sobre MySQL/MariaDB con Claude",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "0.10.*",
        "symfony/finder": "^7.0 || ^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "McpSql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "McpSql\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
